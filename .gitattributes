# Tüm dosyalar için otomatik satır sonu normalizasyonu
* text=auto

# Shell scriptleri her zaman LF olmalı (Linux CI için kritik)
gradlew      text eol=lf
*.sh         text eol=lf

# Windows batch dosyaları CRLF olmalı
*.bat        text eol=crlf
*.cmd        text eol=crlf

# Kaynak kodlar
*.kt         text eol=lf
*.kts        text eol=lf
*.java       text eol=lf
*.xml        text eol=lf
*.json       text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.py         text eol=lf
*.md         text eol=lf

# Binary dosyalar — dönüştürme yapma
*.jar        binary
*.png        binary
*.jpg        binary
*.gif        binary
*.ico        binary
*.zip        binary
*.apk        binary
*.cs3        binary
